{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{IMAGE}}"
    }
  },
  "2": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "4x-UltraSharpV2.safetensors"
    }
  },
  "3": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {
      "upscale_model": [
        "2",
        0
      ],
      "image": [
        "1",
        0
      ]
    }
  },
  "4": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "upscale_method": "lanczos",
      "megapixels": 8.3,
      "resolution_steps": 1,
      "image": [
        "3",
        0
      ]
    }
  },
  "5": {
    "class_type": "SUPIR_Upscale",
    "inputs": {
      "supir_model": "SUPIR-v0Q_fp16.safetensors",
      "sdxl_model": "Juggernaut-XI-byRunDiffusion.safetensors",
      "seed": "{{SEED}}",
      "resize_method": "lanczos",
      "scale_by": 1.0,
      "steps": 20,
      "restoration_scale": -1,
      "cfg_scale": 4.0,
      "a_prompt": "{{A_PROMPT}}",
      "n_prompt": "bad quality, blurry, messy",
      "s_churn": 5,
      "s_noise": 1.003,
      "control_scale": 1.0,
      "cfg_scale_start": 4.0,
      "control_scale_start": 0.0,
      "color_fix_type": "Wavelet",
      "keep_model_loaded": true,
      "use_tiled_vae": true,
      "encoder_tile_size_pixels": 512,
      "decoder_tile_size_latent": 64,
      "diffusion_dtype": "auto",
      "encoder_dtype": "auto",
      "batch_size": 1,
      "use_tiled_sampling": true,
      "sampler_tile_size": 1024,
      "sampler_tile_stride": 512,
      "fp8_unet": false,
      "fp8_vae": false,
      "sampler": "RestoreEDMSampler",
      "image": [
        "4",
        0
      ]
    }
  },
  "6": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "{{OUT_PREFIX}}",
      "images": [
        "5",
        0
      ]
    }
  }
}